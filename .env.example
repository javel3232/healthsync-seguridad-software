# Variables de entorno de HealthSync.
# Copie este archivo como .env antes de levantar la aplicación:
#     cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
#
# Los valores de este archivo son SOLO PARA DESARROLLO Y PRUEBAS. En un despliegue real
# deben cambiarse por secretos propios (por ejemplo: openssl rand -hex 32).

# Caso del proyecto
CASO=healthsync

# Firma de las cookies de sesión (mínimo 32 caracteres)
SECRET_KEY=3f9a1c7e5b2d48a6c0e1f7b9d2a4c6e8f1a3b5d7c9e0f2a4b6c8d0e2f4a6b8c0
# Cambie a true cuando se sirva por HTTPS
COOKIE_SECURE=false

# Base de datos (MySQL 8.4). La aplicación usa MYSQL_USER, no root.
MYSQL_ROOT_PASSWORD=Raiz-Local-2026-xK9mQ2
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=App-Local-2026-vT4nW8

# Cuenta de administrador que se crea al iniciar
ADMIN_EMAIL=admin@healthsync.test
ADMIN_PASSWORD=Admin-Health2026

# Contraseña de todas las cuentas de prueba definidas en casos/healthsync/caso.json
SEED_PASSWORD=Prueba-Health2026

# Robots C++ (mínimo 16 caracteres). Validación de profesionales y monitoreo de alertas.
WORKER_TOKEN=b7e4a1d9c3f60825e1a9d4b7c0f3e6a2
WORKER_INTERVAL_SECONDS=60
WORKER_ALERTAS_INTERVAL_SECONDS=1

# API externa de wearables. Si EXTERNAL_API_BASE_URL queda vacía se usa el simulador local.
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=simulada

# Reglas de negocio (opcionales; estos son los valores por defecto)
# BONO_BIENVENIDA=100          créditos que recibe un paciente al registrarse
# PUNTOS_POR_REFERIDO=50       puntos que gana quien refiere
# PUNTOS_POR_MES_PREMIUM=100   puntos que cuesta un mes de premium
# MAX_TRANSFERENCIA=1000       máximo de créditos por transferencia
# LOGIN_MAX_INTENTOS=5         intentos fallidos antes de bloquear la cuenta
# LOGIN_BLOQUEO_MINUTOS=15
